# ═══════════════════════════════════════════════════════════════════
# NongJames Laundry API - Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nj_laundry

# JWT Configuration
# Must be at least 32 characters for production
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-for-development

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ═══════════════════════════════════════════════════════════════════
# SCB Payment API (Sandbox)
# ═══════════════════════════════════════════════════════════════════
# Get credentials from SCB Developer Portal
SCB_API_URL=https://api.sandbox.scb.co.th
SCB_API_KEY=your_scb_api_key_here
SCB_SECRET_KEY=your_scb_secret_key_here
SCB_MERCHANT_ID=your_scb_merchant_id_here
SCB_BILLER_ID=your_scb_biller_id_here

# ═══════════════════════════════════════════════════════════════════
# LINE Official Account Integration
# ═══════════════════════════════════════════════════════════════════
# Get credentials from LINE Developers Console
LINE_API_URL=https://api.line.me
LINE_CHANNEL_ID=your_line_channel_id_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_ACCESS_TOKEN=your_line_access_token_here
LINE_LIFF_ID=your_line_liff_id_here

# ═══════════════════════════════════════════════════════════════════
# Email Configuration (Optional)
# ═══════════════════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@nongjames-laundry.com

# ═══════════════════════════════════════════════════════════════════
# Logging Configuration
# ═══════════════════════════════════════════════════════════════════
LOG_LEVEL=info
LOG_FORMAT=json

# ═══════════════════════════════════════════════════════════════════
# Rate Limiting
# ═══════════════════════════════════════════════════════════════════
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ═══════════════════════════════════════════════════════════════════
# Redis Configuration (Optional - for caching/sessions)
# ═══════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════
# File Upload Configuration
# ═══════════════════════════════════════════════════════════════════
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
# Cloud storage (optional - for production)
AWS_S3_BUCKET=nj-laundry-uploads
AWS_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
