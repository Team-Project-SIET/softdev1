# ── Database ───────────────────────────────
DATABASE_URL=postgresql://postgres:password for the database user@localhost:5433/name of the database

# ── JWT ────────────────────────────────────
JWT_SECRET=supersecretkey_changeme_in_production

# ── URLs ───────────────────────────────────
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# ── LINE OAuth ─────────────────────────────
# สมัครได้ที่ https://developers.line.biz/
LINE_CLIENT_ID=your_line_client_id
LINE_CLIENT_SECRET=your_line_client_secret
LINE_REDIRECT_URI=http://localhost:8000/auth/line/callback

# ── Google OAuth ───────────────────────────
# สมัครได้ที่ https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback